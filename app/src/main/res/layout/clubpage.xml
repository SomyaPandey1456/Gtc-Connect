<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#f4f4f9"
    android:padding="4sp">

    <!-- Title -->

    <!-- Search Bar -->
    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16sp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/abhaya_libre_extrabold"
        android:text="Find Your Club"
        android:textColor="#1e2432"
        android:textSize="24sp"
        android:textStyle="bold" />


    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/infoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/searchBar"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:drawableStart="@drawable/baseline_info_24"
        android:drawablePadding="8dp"
        android:textColor="#000000"
        android:textSize="16sp" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"
        android:indeterminate="true" />

    <EditText
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="12sp"
        android:layout_marginTop="6sp"
        android:layout_marginEnd="12sp"
        android:layout_marginBottom="16sp"
        android:background="@android:drawable/edit_text"
        android:drawableLeft="@android:drawable/ic_menu_search"
        android:drawablePadding="8sp"
        android:hint="Search for a tech club..."
        android:inputType="text"
        android:padding="10sp"
        android:textSize="16sp" />

    <!-- ListView for Clubs -->
    <ListView
        android:id="@+id/clubList"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/searchBar"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="0sp"
        android:layout_marginEnd="0sp"
        android:background="#ffffff"
        android:divider="@android:color/darker_gray"
        android:dividerHeight="1sp" />
</RelativeLayout>
